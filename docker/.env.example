# Database Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=devices_manager
MYSQL_PORT=3306

# Database Users (created by mariadb-init/01-init-database.sql)
# Flyway user - Full schema management rights for migrations
MYSQL_FLYWAY_USER=flyway_user
MYSQL_FLYWAY_PASSWORD=flyway_pass

# Registration user - Read/write for device-registration-api
MYSQL_REGISTRATION_USER=registration_user
MYSQL_REGISTRATION_PASSWORD=registration_pass

# Statistics user - Read-only for statistics-api
MYSQL_STATISTICS_USER=statistics_user
MYSQL_STATISTICS_PASSWORD=statistics_pass

# Application Configuration
SPRING_PROFILES_ACTIVE=dev

# Service Ports
STATISTICS_API_PORT=8080
DEVICE_REGISTRATION_API_PORT=8081
DEVICE_VIEWER_PORT=8082

# Device Registration API Key
DEVICE_REGISTRATION_API_KEY=00000000-0000-0000-0000-000000000000
